# development | test | production
CATALYST_CANVAS_ENV=development

# Required when CATALYST_CANVAS_ENV is not development, local, or test.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CATALYST_CANVAS_SECRET=

# Optional. Defaults to ./catalyst.sqlite3 for local development.
CATALYST_CANVAS_DB=

# Optional stable local workspace boundary.
CATALYST_CANVAS_WORKSPACE_ID=workspace-local-default
