{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/catalyst_canvas_workspace_1_0.schema.json",
  "title": "Catalyst Canvas Workspace Project Contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workspace_id", "project_id", "title", "description", "status",
    "tags", "created_at", "updated_at", "archived_at", "current_canvas_id",
    "current_revision_id", "revision_count"
  ],
  "properties": {
    "schema_version": {"const": "catalyst-canvas-workspace/1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^project-"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"enum": ["active", "archived"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "archived_at": {"type": "string"},
    "current_canvas_id": {"type": "string", "pattern": "^canvas-"},
    "current_revision_id": {"type": "string", "pattern": "^revision-"},
    "revision_count": {"type": "integer", "minimum": 1}
  }
}
