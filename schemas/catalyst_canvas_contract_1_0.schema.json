{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/catalyst_canvas_contract_1_0.schema.json",
  "title": "Catalyst Canvas Contract 1.0",
  "description": "Canonical interoperable contract for Catalyst Canvas surfaces.",
  "type": "object",
  "required": [
    "schema_version",
    "canvas_id",
    "revision_id",
    "title",
    "status",
    "owner_context",
    "created_at",
    "updated_at",
    "challenge",
    "audience",
    "goal",
    "constraints",
    "personas",
    "stakeholders",
    "point_of_view",
    "how_might_we",
    "framework",
    "evidence",
    "assumptions",
    "prototypes",
    "tests",
    "review_notes",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "catalyst-canvas/1.0"
    },
    "canvas_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "review",
        "validated",
        "archived"
      ]
    },
    "owner_context": {
      "$ref": "#/$defs/owner_context"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "challenge": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "$ref": "#/$defs/audience"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stakeholder"
      }
    },
    "point_of_view": {
      "$ref": "#/$defs/point_of_view"
    },
    "how_might_we": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/how_might_we"
      }
    },
    "framework": {
      "$ref": "#/$defs/framework"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "prototypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prototype"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_note"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "owner_context": {
      "type": "object",
      "required": [
        "owner_id",
        "name",
        "organization",
        "role"
      ],
      "properties": {
        "owner_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "affected",
        "excluded"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "constraint_id",
        "statement",
        "source"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "persona": {
      "type": "object",
      "required": [
        "persona_id",
        "name",
        "role",
        "description",
        "needs",
        "pains",
        "source_type",
        "confidence"
      ],
      "properties": {
        "persona_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_type": {
          "type": "string",
          "enum": [
            "observed",
            "research",
            "assumption",
            "mixed"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "stakeholder": {
      "type": "object",
      "required": [
        "stakeholder_id",
        "name",
        "relationship",
        "influence",
        "interest",
        "notes"
      ],
      "properties": {
        "stakeholder_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string"
        },
        "influence": {
          "type": "string"
        },
        "interest": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "point_of_view": {
      "type": "object",
      "required": [
        "statement",
        "persona_id"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "persona_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "how_might_we": {
      "type": "object",
      "required": [
        "hmw_id",
        "question",
        "status"
      ],
      "properties": {
        "hmw_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "selected",
            "retired"
          ]
        }
      },
      "additionalProperties": false
    },
    "framework_prompt": {
      "type": "object",
      "required": [
        "prompt_id",
        "label",
        "question"
      ],
      "properties": {
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "framework": {
      "type": "object",
      "required": [
        "key",
        "name",
        "prompts"
      ],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "AIDA",
            "JTBD",
            "Hero",
            "Matrix"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/framework_prompt"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "type",
        "title",
        "summary",
        "citation",
        "confidence"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "assumption_id",
        "statement",
        "status",
        "criticality"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "untested",
            "testing",
            "supported",
            "challenged",
            "retired"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "prototype": {
      "type": "object",
      "required": [
        "prototype_id",
        "title",
        "description",
        "status"
      ],
      "properties": {
        "prototype_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "concept",
            "planned",
            "active",
            "tested",
            "retired"
          ]
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "test_id",
        "title",
        "signal",
        "method",
        "learning_goal",
        "status"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "learning_goal": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "complete",
            "cancelled"
          ]
        }
      },
      "additionalProperties": false
    },
    "review_note": {
      "type": "object",
      "required": [
        "review_note_id",
        "type",
        "note",
        "status"
      ],
      "properties": {
        "review_note_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "note",
            "risk",
            "review_question",
            "decision"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "accepted"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "generator",
        "generator_version",
        "source_surface",
        "source_version",
        "migrated_from",
        "warnings"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "const": "catalyst-canvas"
        },
        "generator_version": {
          "type": "string",
          "const": "1.3.0"
        },
        "source_surface": {
          "type": "string",
          "enum": [
            "python",
            "cli",
            "flask",
            "wordpress",
            "import",
            "migration",
            "fixture"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "migrated_from": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
